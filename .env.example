# GEMINI_API_KEY: Required for Gemini AI API calls.
# Configure this value in your local environment or hosting provider.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Optional: Supabase integration (client-side URL & anon key)
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""

# Optional: Wearable OAuth credentials (server-side only)
FITBIT_CLIENT_ID=""
FITBIT_CLIENT_SECRET=""
GARMIN_CONSUMER_KEY=""
GARMIN_CONSUMER_SECRET=""
